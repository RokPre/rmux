#!/usr/bin/env bash
set -euo pipefail

root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
if [[ -n ${RMUX_BIN:-} ]]; then
  exec "$RMUX_BIN" "$@"
fi
for binary in "$root/target/debug/rmux" "$root/target/release/rmux"; do
  [[ -x $binary ]] && exec "$binary" "$@"
done
printf 'rmux: build the Rust client first with `cargo build --manifest-path %s/Cargo.toml`\n' "$root" >&2
exit 1
